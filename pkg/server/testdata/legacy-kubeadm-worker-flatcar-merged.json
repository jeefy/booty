  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Tell Booty this host finished installing (clears doInstall)\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/bash -c 'set -- $$(ip -o route get 1); while [ $$# -gt 1 ] \u0026\u0026 [ \"$$1\" != dev ]; do shift; done; MAC=$$(cat /sys/class/net/$$2/address); curl -fsS --retry 5 --retry-connrefused -X POST \"http://192.168.1.10:8080/booted?mac=$$MAC\"'\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "booty-booted.service"
      },
      {
        "contents": "[Unit]\nDescription=Ask Booty whether this host needs a reboot to pick up an update\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/opt/booty/update-check\n",
        "name": "booty-update.service"
      },
      {
        "contents": "[Unit]\nDescription=Run the Booty update check every 10 minutes\n\n[Timer]\nOnCalendar=*:0/10\nRandomizedDelaySec=60\nPersistent=false\n\n[Install]\nWantedBy=timers.target\n",
        "enabled": true,
        "name": "booty-update.timer"
      },
      {
        "contents": "[Unit]\nDescription=Mount the ephemeral containerd disk at /var/lib/containerd\nBefore=local-fs.target\n\n[Mount]\nWhat=/dev/disk/by-label/ssd\nWhere=/var/lib/containerd\nType=ext4\n\n[Install]\nWantedBy=local-fs.target\n",
        "enabled": true,
        "name": "var-lib-containerd.mount"
      },
      {
        "dropins": [
          {
            "contents": "[Unit]\nAfter=var-lib-containerd.mount\nRequires=var-lib-containerd.mount\n",
            "name": "10-wait-containerd.conf"
          }
        ],
        "name": "containerd.service"
      },
      {
        "contents": "[Unit]\nDescription=Install CNI plugins v1.1.1\nRequires=network-online.target\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/opt/booty/cni.sh\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "booty-cni-install.service"
      },
      {
        "contents": "[Unit]\nDescription=Install kubeadm, kubelet, kubectl and crictl v1.34.3\nRequires=booty-cni-install.service\nAfter=booty-cni-install.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/opt/booty/kube-tools.sh\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "booty-kube-tools.service"
      },
      {
        "contents": "[Unit]\nDescription=Run containerd with systemd cgroups for the kubelet\nRequires=booty-kube-tools.service\nAfter=booty-kube-tools.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/opt/booty/containerd.sh\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "booty-containerd-setup.service"
      },
      {
        "contents": "[Unit]\nDescription=Install the kubelet systemd units\nRequires=booty-containerd-setup.service\nAfter=booty-containerd-setup.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/opt/booty/systemd.sh\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "booty-kubelet-setup.service"
      },
      {
        "contents": "[Unit]\nDescription=Join the Kubernetes cluster with kubeadm\nRequires=booty-kubelet-setup.service\nAfter=booty-kubelet-setup.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nRestart=on-failure\nRestartSec=30s\nEnvironment=\"JOIN_STRING=kubeadm join 10.0.0.1:6443 --token abcdef.0123456789abcdef --discovery-token-ca-cert-hash sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"\nExecStart=/bin/bash -c 'PATH=/opt/bin:$$PATH exec /opt/booty/join.sh'\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "booty-k8s-join.service"
      }
    ]
  }
}