{
  "ignition": {
    "version": "3.6.0"
  },
  "storage": {
    "disks": [
      {
        "device": "/dev/vdb",
        "wipeTable": false,
        "partitions": [
          {
            "number": 1,
            "label": "bluefin-var",
            "wipePartitionEntry": false
          }
        ]
      }
    ],
    "filesystems": [
      {
        "device": "/dev/disk/by-partlabel/bluefin-var",
        "format": "xfs",
        "label": "bluefin-var",
        "wipeFilesystem": false
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "name": "var.mount",
        "enabled": true,
        "contents": "[Unit]\nDescription=Persistent /var on the Ignition-provisioned disk\n\n[Mount]\nWhat=/dev/disk/by-label/bluefin-var\nWhere=/var\nType=xfs\nOptions=defaults\n\n[Install]\nWantedBy=local-fs.target\n"
      }
    ]
  },
  "passwd": {
    "users": [
      {
        "name": "root",
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAA... dogfood"
        ]
      }
    ]
  }
}
